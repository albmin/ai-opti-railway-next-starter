# =============================================================================
# Application Configuration
# =============================================================================
NODE_ENV=development
LOG_LEVEL=debug
APP_NAME=ai-opti-nextjs-starter

# =============================================================================
# Database (Railway Postgres)
# =============================================================================
# On Railway: add a Postgres service, then on THIS service add a Reference
# Variable:  DATABASE_URL = ${{Postgres.DATABASE_URL}}
# That resolves to the private-network host (postgres.railway.internal) — no
# public egress. For local dev, use the Postgres service's PUBLIC proxy URL from
# the Railway dashboard, or a throwaway local container:
#   docker run -d --name pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:17
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# =============================================================================
# Better Auth
# =============================================================================
# Generate a strong secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public base URL of the app.
#   local:    http://localhost:3000
#   Railway:  https://your-app.up.railway.app  (your service's public domain)
BETTER_AUTH_URL=http://localhost:3000
